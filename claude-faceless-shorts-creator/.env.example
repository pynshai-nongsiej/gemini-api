# Copy to .env (repo root) and fill in what you use.

# LOCAL AI (default) — the gemini-web2api proxy (OpenAI-compatible) used by
# tools/gen_script.py + tools/make_short.py for scripts/beats. No key needed.
LOCAL_AI_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_AI_MODEL=gemini-3.6-flash

# LOCAL Kokoro TTS — required for voice (tools/gen_voice.py, tools/make_short.py).
# Model files from https://github.com/thewh1teagle/kokoro-onnx (v1.0).
KOKORO_MODEL_PATH=/path/to/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/path/to/voices-v1.0.bin
KOKORO_VOICE=bm_george
KOKORO_SPEED=1.0

# Image generation — free keyless Pollinations FLUX (tools/gen_image.py).
POLLINATIONS_MODEL=flux

# Operator & management layer (operator/server.js) — job queue, review gate,
# publish scheduling, dashboard on http://localhost:3457.
OPERATOR_PORT=3457
# OPERATOR_API_KEY=change-me        # protects ALL mutating routes (x-api-key header)
# GOOGLE_CLIENT_ID=                 # YouTube upload OAuth (optional until publishing)
# GOOGLE_CLIENT_SECRET=

# ElevenLabs — OPTIONAL: upgrades SFX (gen_sfx.py) and music (gen_music.py)
# from local ffmpeg synthesis to neural generation. Without it those tools
# fall back to offline synthesis automatically.
ELEVENLABS_API_KEY=

# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=
